# ===================================================================
# Server Configuration
# ===================================================================
PORT=8080
ENV=development

# External Port Mapping
# Default is 3000 to avoid conflicts with common services on port 8080
# Change to another port if needed: API_PORT=9090, API_PORT=5000, etc.
# IMPORTANT: Also update BASE_URL below to match your API_PORT
API_PORT=3000

# ===================================================================
# DynamoDB Configuration
# ===================================================================
# Choose ONE of two options:

# OPTION 1: Local DynamoDB (NO AWS ACCOUNT NEEDED!)
# Perfect for testing without AWS
USE_LOCAL_DYNAMODB=true
DYNAMODB_LOCAL_ENDPOINT=http://localhost:8000

# OPTION 2: AWS DynamoDB (Requires AWS Account)
# Set USE_LOCAL_DYNAMODB=false and provide real credentials
# USE_LOCAL_DYNAMODB=false
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# Table names (same for both local and AWS)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy
DYNAMODB_URLS_TABLE=urls
DYNAMODB_ANALYTICS_TABLE=analytics

# ===================================================================
# Redis Configuration
# ===================================================================
REDIS_URL=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ===================================================================
# Application Settings
# ===================================================================
# Base URL for shortened links - should match your API_PORT above
# If you changed API_PORT to 9090, change this to http://localhost:9090
BASE_URL=http://localhost:3000
SHORT_CODE_LENGTH=6
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ===================================================================
# GeoIP Configuration (optional)
# ===================================================================
GEOIP_DB_PATH=/path/to/GeoLite2-City.mmdb
